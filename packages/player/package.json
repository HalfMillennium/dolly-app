{
  "name": "@dolly/player",
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable walkthrough player: watch a recording (video + synthetic cursor) or run it live in the viewer's own page (auto-run or coach), with self-healing element resolution.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dolly/schema": "workspace:*",
    "@dolly/selector": "workspace:*",
    "@dolly/cursor": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
