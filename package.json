{
  "name": "dolly",
  "version": "0.1.0",
  "private": true,
  "description": "DOLLY — browser tool for DOM-aware, self-healing product walkthroughs: record clicks, watch as video with a rendered cursor, or replay live in your own browser (auto-run or coach)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "gen": "pnpm --filter @dolly/schema gen",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
