    "test": "vitest run"
  },
  "dependencies": {
    "@dolly/player": "workspace:*",
    "@dolly/schema": "workspace:*"
  },
  "devDependencies": {
    "@dolly/selector": "workspace:*",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
