{
  "name": "@dolly/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Integration demo: a mock product page embedding <dolly-walkthrough>, proving watch + live (auto-run/coach) replay with self-healing against a real DOM.",
