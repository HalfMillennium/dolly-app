{
  "name": "@dolly/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DOLLY authoring extension (MV3): record DOM-aware click-throughs, capture the tab to webm, review/annotate steps, export a Recording + embed snippet.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dolly/cursor": "workspace:*",
    "@dolly/player": "workspace:*",
    "@dolly/recorder": "workspace:*",
    "@dolly/schema": "workspace:*",
    "@dolly/selector": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
