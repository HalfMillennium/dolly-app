<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist merged into the generated bundle by Tauri (a file named Info.plist
  next to tauri.conf.json is merged onto Tauri's generated keys on macOS). Only the keys
  DOLLY needs beyond Tauri's defaults live here.

  NOTE on Screen Recording: there is intentionally NO usage-description key for screen
  capture. macOS gates Screen Recording purely through TCC at first CGRequestScreenCaptureAccess()
  / SCShareableContent access — there is no NS*UsageDescription string for it, unlike mic/camera
  (BUILD_PLAN §5.4). Adding one would be ignored.
-->
<plist version="1.0">
<dict>
    <!-- Shown when the app first requests the microphone for the mic audio track (§5.4, §8). -->
    <key>NSMicrophoneUsageDescription</key>
    <string>DOLLY records your microphone as a separate audio track so you can balance or mute it when exporting.</string>

    <!-- Present for the v1.1 camera overlay / picture-in-picture feature (§1 deferred, §8).
         Harmless in v1: the prompt only appears if the app actually touches the camera. -->
    <key>NSCameraUsageDescription</key>
    <string>DOLLY can record your camera as a picture-in-picture overlay.</string>

    <!-- The .dolly project bundle is an opaque package in Finder (§3.1). -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
</dict>
</plist>
