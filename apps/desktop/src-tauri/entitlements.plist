<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for the DOLLY .app (BUILD_PLAN §8).

  DELIBERATELY ABSENT: com.apple.security.app-sandbox.
  DOLLY is NOT sandboxed for v1. ScreenCaptureKit, NSEvent global monitors, spawning
  the `dollyd` sidecar as a child process, and writing .dolly bundles to arbitrary
  user-chosen locations are all incompatible with the App Sandbox's containerization.
  Distribution is Developer ID + notarization (not the Mac App Store), so the sandbox
  is not required. Do not add com.apple.security.app-sandbox — it will break capture.
-->
<plist version="1.0">
<dict>
    <!-- Microphone capture for the mic track (AVCaptureSession). The only TCC-gated
         hardware entitlement the app needs; Screen Recording is a TCC prompt, not an
         entitlement (see Info.plist comment). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- WKWebView requires a JIT-capable, writable/executable memory region for its
         JavaScriptCore tier-up. Without these three, the webview fails to load or
         crashes under hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allows the hardened-runtime process to load libraries/frameworks and the
         separately-signed `dollyd` sidecar without strict same-team library validation. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
